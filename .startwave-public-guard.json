  "deniedPrefixes": [
    ".startwave-agent/",
    "agents/",
    "brain/",
    "credentials/",
    "docs/private/",
    "factory/",
    "internal/",
    "keys/",
    "logs/",
    "private/",
    "prompts/",
    "policies/",
    "rules/",
    "secrets/",
    "skills/",
    "tools/",
    "validation/",
    "tools/atlas-agent/",
    "tools/startwave-agent/",
    "GAMES/Mir_Kameadril/",
    "assets/data/bdo-"
  ],
  "deniedSegments": [
    "agents",
    "credentials",
    "keys",
    "logs",
    "private",
    "secrets"
  ],
  "deniedExact": [
    "AGENTS.md",
    "PROJECT_SPEC.md",
    "PROJECT_VISION.md",
    "ROADMAP.md",
    "DESIGN_SYSTEM.md",
    "codex-cheatsheet.md",
