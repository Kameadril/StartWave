{
  "schemaVersion": 2,
  "git": {
    "firstPushBaseRefs": [
      "refs/remotes/origin/factory"
    ]
  },
  "allowedExact": [
    ".gitignore",
    ".startwave-public-guard.json",
    ".githooks/pre-commit",
    ".githooks/pre-push",
    ".github/workflows/ci.yml",
    ".github/workflows/cloudflare-preview.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "COMMIT_GUIDE.md",
    "TESTING.md",
    "VERSION.md",
    "package.json",
    "wrangler.jsonc",
    "wrangler.bdo.jsonc",
    "index.html",
    "index_old.html",
    "ai.html",
    "bdo.html",
    "entertainment.html",
    "games.html",
    "profile.html",
    "services.html",
    "assets/data/daily-cards.js",
    "assets/data/daily-wave-data.js",
    "docs/ATLAS_PRE_MIGRATION_SHA256.txt",
    "docs/COMPONENTS.md",
    "docs/STARTWAVE_CHECKLIST.md",
    "docs/STARTWAVE_GAMES_ARCHITECTURE.md",
    "docs/STARTWAVE_PHILOSOPHY.md",
    "docs/STARTWAVE_PRE_MIGRATION_INVENTORY.md",
    "docs/STARTWAVE_RELEASE.md",
    "docs/STARTWAVE_STYLE_GUIDE.md",
    "docs/STARTWAVE_TERMS.md",
