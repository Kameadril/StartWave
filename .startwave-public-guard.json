    "docs/STARTWAVE_EDITORIAL_PROMPT.md",
    "scripts/atlas-agent.ps1",
    "scripts/startwave-agent.ps1"
  ],
  "deniedBasenames": [
    ".env",
    "auth.json"
  ],
  "deniedExtensions": [
    ".db",
    ".key",
    ".log",
    ".pem",
    ".sqlite",
    ".sqlite-shm",
    ".sqlite-wal"
  ],
  "artifacts": {
    "dist": {
      "allowedExact": [
        "_redirects",
        "ai.html",
        "entertainment.html",
        "games.html",
        "index.html",
        "profile.html",
        "services.html"
      ],
      "allowedPrefixes": [
        "assets/"
      ]
    },
    "dist-bdo": {
      "allowedExact": [
        "alchemy.html",
        "auction.html",
        "barter.html",
        "cities.html",
        "cooking.html",
        "crafting.html",
        "database.html",
        "farming.html",
        "fishing.html",
        "index.html",
        "items.html",
        "knowledge-chain.html",
        "knowledge-layer.html",
        "nodes.html",
        "notes.html",
        "player-knowledge.html",
        "production.html",
        "recipes.html",
        "region-calpheon.html",
        "regions.html",
        "resources.html",
        "robots.txt",
        "sitemap.xml",
        "workers.html",
        "world-connection.html"
      ],
      "allowedPrefixes": [
        "assets/"
      ]
    }
  }
}
