    "scripts/publication-guard.mjs",
    "scripts/publication-guard.test.mjs",
    "scripts/repository-test-temp.mjs",
    "scripts/cloudflare-preview-policy.mjs",
    "scripts/cloudflare-preview-policy.test.mjs",
    "scripts/cloudflare-preview-workflow.test.mjs",
    "scripts/install-publication-guard.sh",
    "scripts/install-publication-guard.ps1"
  ],
  "allowedPrefixes": [
    "apps/web/",
    "GAMES/site/",
    "GAMES/bdo/site/",
    "GAMES/bdo/atlas/data/",
    "GAMES/bdo/atlas/docs/",
    "GAMES/bdo/tools/",
    "GAMES/bdo/atlas/validation/",
    "ai/",
    "services/",
    "shared/",
    "infra/",
    "docs/architecture/",
    "assets/css/",
    "assets/images/",
    "assets/js/",
    "pages/"
