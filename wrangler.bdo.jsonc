{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startwave-bdo",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist-bdo",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "bdo.startwave.space",
      "custom_domain": true
    }
  ]
}
